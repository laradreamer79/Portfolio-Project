          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/trips/{{tripId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "trips", "{{tripId}}"]
            }
