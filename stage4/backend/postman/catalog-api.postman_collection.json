{
  "info": {
    "name": "Oyster Catalog API",
    "description": "Postman tests for diving centers, trips, courses, search, filters, details, CRUD, and image uploads.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Diving Centers",
      "item": [
        {
          "name": "List centers with search and filters",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('returns an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/centers?search=sea&city=Jeddah&status=approved",
              "host": ["{{baseUrl}}"],
              "path": ["api", "centers"],
              "query": [
                { "key": "search", "value": "sea" },
                { "key": "city", "value": "Jeddah" },
                { "key": "status", "value": "approved" }
              ]
            }
          }
        },
        {
          "name": "Create center with image",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('returns 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('stores center id', function () { pm.collectionVariables.set('centerId', pm.response.json().id); });",
                  "pm.test('has image url when file is sent', function () { pm.expect(pm.response.json()).to.have.property('imageUrl'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Blue Lagoon Diving Center", "type": "text" },
                { "key": "city", "value": "Jeddah", "type": "text" },
                { "key": "address", "value": "North Obhur", "type": "text" },
                { "key": "licenseNumber", "value": "LIC-POSTMAN-{{$timestamp}}", "type": "text" },
                { "key": "description", "value": "Catalog API test center", "type": "text" },
                { "key": "priceRange", "value": "250-700 SAR", "type": "text" },
                { "key": "contactEmail", "value": "catalog@example.com", "type": "text" },
                { "key": "contactPhone", "value": "+966500000001", "type": "text" },
                { "key": "image", "type": "file", "src": "" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/centers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "centers"]
            }
          }
        },
        {
          "name": "Get center detail",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('includes related counts', function () { pm.expect(pm.response.json()).to.have.property('_count'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/centers/{{centerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "centers", "{{centerId}}"]
            }
          }
        },
        {
          "name": "Update center",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('updates name', function () { pm.expect(pm.response.json().name).to.include('Updated'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "PUT",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Updated Blue Lagoon Diving Center", "type": "text" },
                { "key": "city", "value": "Jeddah", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/centers/{{centerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "centers", "{{centerId}}"]
            }
          }
        }
      ]
    },
